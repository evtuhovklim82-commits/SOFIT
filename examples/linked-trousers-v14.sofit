{\"control\":\"\",\"end\":\"TBCrotch\",\"name\":\"trouser_back_inseam_upper\",\"start\":\"TBInnerKnee\"},{\"control\":\"TBSeatControl\",\"end\":\"TBCenterHip\",\"name\":\"trouser_back_crotch\",\"start\":\"TBCrotch\"},{\"control\":\"\",\"end\":\"TBCenterWaist\",\"name\":\"trouser_back_rise\",\"start\":\"TBCenterHip\"},{\"control\":\"\",\"end\":\"TBSideSeat\",\"name\":\"trouser_back_guide_seat\",\"start\":\"TBCrotch\"},{\"control\":\"\",\"end\":\"TBOuterKnee\",\"name\":\"trouser_back_guide_knee\",\"start\":\"TBInnerKnee\"},{\"control\":\"\",\"end\":\"TBDartTip\",\"name\":\"trouser_back_dart_left\",\"start\":\"TBDartLeft\"},{\"control\":\"\",\"end\":\"TBDartRight\",\"name\":\"trouser_back_dart_right\",\"start\":\"TBDartTip\"}],\"measurements\":[{\"mm\":740,\"name\":\"waist\"},{\"mm\":1000,\"name\":\"hip\"},{\"mm\":40,\"name\":\"waist_ease\"},{\"mm\":60,\"name\":\"hip_ease\"},{\"mm\":195,\"name\":\"hip_depth\"},{\"mm\":270,\"name\":\"rise\"},{\"mm\":600,\"name\":\"knee_depth\"},{\"mm\":1030,\"name\":\"length\"},{\"mm\":460,\"name\":\"knee\"},{\"mm\":380,\"name\":\"hem\"},{\"mm\":100,\"name\":\"dart_length\"}],\"parameters\":[{\"formula\":\"(hip + hip_ease) / 4\",\"name\":\"hip_width\"},{\"formula\":\"hip_width - (waist + waist_ease) / 4\",\"name\":\"suppression\"},{\"formula\":\"hip_width - suppression / 2\",\"name\":\"side_waist\"},{\"formula\":\"suppression / 4\",\"name\":\"dart_half\"},{\"formula\":\"hip_width * 0.17\",\"name\":\"front_extension\"},{\"formula\":\"hip_width * 0.31\",\"name\":\"back_extension\"},{\"formula\":\"(hip_width - (front_extension + back_extension) / 2) / 2\",\"name\":\"leg_axis\"},{\"formula\":\"hip_width + back_extension + knee + hem + 40\",\"name\":\"back_offset\"}],\"points\":[{\"name\":\"TFCenterWaist\",\"x\":\"0 + (0)\",\"y\":\"0\"},{\"name\":\"TFSideWaist\",\"x\":\"0 + (side_waist)\",\"y\":\"0\"},{\"name\":\"TFCenterHip\",\"x\":\"0 + (0)\",\"y\":\"hip_depth\"},{\"name\":\"TFSideHip\",\"x\":\"0 + (hip_width)\",\"y\":\"hip_depth\"},{\"name\":\"TFSideHipControl\",\"x\":\"0 + (hip_width)\",\"y\":\"hip_depth / 2\"},{\"name\":\"TFSideSeat\",\"x\":\"0 + (hip_width)\",\"y\":\"rise\"},{\"name\":\"TFSeatControl\",\"x\":\"0 + (0)\",\"y\":\"rise\"},{\"name\":\"TFCrotch\",\"x\":\"0 + (-front_extension)\",\"y\":\"rise\"},{\"name\":\"TFOuterKnee\",\"x\":\"0 + (leg_axis + knee / 4)\",\"y\":\"knee_depth\"},{\"name\":\"TFInnerKnee\",\"x\":\"0 + (leg_axis - knee / 4 + (front_extension + back_extension) / 2 - front_extension)\",\"y\":\"knee_depth\"},{\"name\":\"TFOuterHem\",\"x\":\"0 + (leg_axis + hem / 4)\",\"y\":\"length\"},{\"name\":\"TFInnerHem\",\"x\":\"0 + (leg_axis - hem / 4 + (front_extension + back_extension) / 2 - front_extension)\",\"y\":\"length\"},{\"name\":\"TFDartLeft\",\"x\":\"0 + (side_waist / 2 - dart_half)\",\"y\":\"0\"},{\"name\":\"TFDartRight\",\"x\":\"0 + (side_waist / 2 + dart_half)\",\"y\":\"0\"},{\"name\":\"TFDartTip\",\"x\":\"0 + (side_waist / 2)\",\"y\":\"dart_length\"},{\"name\":\"TBCenterWaist\",\"x\":\"back_offset + (0)\",\"y\":\"0\"},{\"name\":\"TBSideWaist\",\"x\":\"back_offset + (side_waist)\",\"y\":\"0\"},{\"name\":\"TBCenterHip\",\"x\":\"back_offset + (0)\",\"y\":\"hip_depth\"},{\"name\":\"TBSideHip\",\"x\":\"back_offset + (hip_width)\",\"y\":\"hip_depth\"},{\"name\":\"TBSideHipControl\",\"x\":\"back_offset + (hip_width)\",\"y\":\"hip_depth / 2\"},{\"name\":\"TBSideSeat\",\"x\":\"back_offset + (hip_width)\",\"y\":\"rise\"},{\"name\":\"TBSeatControl\",\"x\":\"back_offset + (0)\",\"y\":\"rise\"},{\"name\":\"TBCrotch\",\"x\":\"back_offset + (-back_extension)\",\"y\":\"rise\"},{\"name\":\"TBOuterKnee\",\"x\":\"back_offset + (leg_axis + knee / 4)\",\"y\":\"knee_depth\"},{\"name\":\"TBInnerKnee\",\"x\":\"back_offset + (leg_axis - knee / 4 + (front_extension + back_extension) / 2 - back_extension)\",\"y\":\"knee_depth\"},{\"name\":\"TBOuterHem\",\"x\":\"back_offset + (leg_axis + hem / 4)\",\"y\":\"length\"},{\"name\":\"TBInnerHem\",\"x\":\"back_offset + (leg_axis - hem / 4 + (front_extensi