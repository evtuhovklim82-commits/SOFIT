function(run_sofit)
    execute_process(COMMAND "${SOFIT}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "SOFIT returned ${result}\n${output}\n${error}")
    endif()
endfunction()

file(MAKE_DIRECTORY "${OUTPUT}")
set(report "${OUTPUT}/trousers.json")
set(dxf "${OUTPUT}/apron.dxf")
set(pdf "${OUTPUT}/apron.pdf")
file(REMOVE "${report}" "${dxf}" "${pdf}")

run_sofit(--production-report "${report}" "${EXAMPLES}/linked-trousers-v14.sofit")
file(READ "${report}" json)
string(JSON passed GET "${json}" passed)
string(JSON size_count LENGTH "${json}" sizes)
string(JSON seam_count LENGTH "${json}" sizes 2 seams)
if(NOT passed OR NOT size_count EQUAL 3 OR seam_count LESS 1)
    message(FATAL_ERROR "Expected passing base, L and XL reports with linked seams")
endif()

run_sofit(--marker-dxf "${dxf}" "${EXAMPLES}/bib-apron.sofit")
run_sofit(--marker-pdf "${pdf}" "${EXAMPLES}/bib-apron.sofit")
file(READ "${dxf}" drawing)
file(READ "${pdf}" header LIMIT 5 HEX)
if(NOT drawing MATCHES "ENTITIES" OR NOT header STREQUAL "255044462d")
    message(FATAL_ERROR "Expected DXF and PDF marker exports")
endif()
